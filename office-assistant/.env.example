# Postgres connection string
DATABASE_URL=postgres://localhost:5432/office_assistant

# 32 random bytes, base64. Encrypts per tenant connector credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Claude API
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-opus-5-5
CLASSIFIER_EFFORT=low

# Public base URL of this service, used when registering webhooks with Quo
PUBLIC_BASE_URL=https://office-assistant.fly.dev

# Quo REST API base (OpenPhone rebranded to Quo; override if the host changes)
QUO_API_BASE=https://api.openphone.com/v1

# Login token for the web app. Pick a long random string.
ADMIN_TOKEN=

# Product name shown in the app
PRODUCT_NAME=Office

PORT=8080
