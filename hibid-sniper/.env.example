# Copy to .env for local runs. .env is git-ignored — never commit it,
# never paste these values into a chat, ticket, or screenshot.

# Protects the dashboard itself behind a password screen. Required on any
# public deploy (Fly gives every app a public URL by default). Leave
# blank locally if you don't want the gate while developing.
DASHBOARD_PASSWORD=

# Your HiBid login, used as a scripted-login fallback when there's no
# saved session (data/auth.json). Skip these and use HIBID_AUTH_STATE_B64
# instead (see README) if you'd rather not store a password at all.
HIBID_EMAIL=
HIBID_PASSWORD=

# When true, the engine uses a simulated auction instead of a real
# Playwright browser — no network, no hibid.com, safe to run anywhere.
# Useful to unblock a deploy immediately while selectors.ts still needs
# calibrating against the real site.
DEMO_MODE=false

PORT=8080
DEFAULT_SNIPE_SECONDS=8
