# Copy this file to .env and fill it in. .env is git-ignored — never commit it,
# never paste these values into a chat, ticket, or screenshot.

# Your HiBid login. Only used to attempt automated login; if that doesn't
# work (2FA, captcha, changed login form) just log in manually once via
# `npm run inspect` instead and the bot will reuse that saved session.
HIBID_EMAIL=
HIBID_PASSWORD=

# Port for the local dashboard (open http://localhost:PORT on your phone
# while on the same network, or use a tunnel like Tailscale/ngrok).
PORT=4310

# How many seconds before a lot's scheduled close the bot should start
# actively bidding, for lots set to "snipe" mode instead of "proxy" mode.
DEFAULT_SNIPE_SECONDS=8
