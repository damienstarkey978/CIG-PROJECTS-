# Copy to .env for local runs. .env is git-ignored — never commit it,
# never paste these values into a chat, ticket, or screenshot.

# Protects the dashboard itself behind a password screen. Required on any
# public deploy (Fly gives every app a public URL by default). Leave
# blank locally if you don't want the gate while developing.
DASHBOARD_PASSWORD=

# Preferred for real bidding: a captured Playwright storageState, base64.
# Create it with `npm run inspect -- <lot-url>` (log in by hand once), then:
#   base64 -w0 data/auth.json
# Set the result as this secret on Fly. On boot the app writes it to
# data/auth.json. Never commit the decoded file.
HIBID_AUTH_STATE_B64=

# Scripted-login fallback when there's no saved session. HiBid login is a
# two-step modal and often shows Cloudflare Turnstile — scripted login can
# fail. Prefer HIBID_AUTH_STATE_B64 above.
HIBID_EMAIL=
HIBID_PASSWORD=

# When true, the engine uses a simulated auction instead of a real
# Playwright browser — no network, no hibid.com. Use this to confirm the
# dashboard/engine are healthy, or to run before a HiBid session is saved.
DEMO_MODE=false

PORT=8080
DEFAULT_SNIPE_SECONDS=8
